# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Node / Frontend dependencies and build outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local

# Node package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Python virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Databases and runtime data
*.db
*.sqlite
*.sqlite3
backend/warehouse.db
backend/data/*.db

# Large media / datasets / model weights (preserving directory structures via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/trajectories/*
!data/trajectories/.gitkeep
data/events/*
!data/events/.gitkeep
data/database/*
!data/database/.gitkeep
models/*
!models/.gitkeep
*.pt
*.pth
*.bin
*.onnx
*.weights
*.h5

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDEs and editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
