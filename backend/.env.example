# ==========================================
# Warehouse Intelligence Platform Configuration
# ==========================================

# Google Gemini AI Integration (for Incident Q&A Assistant)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=1024

# Roboflow Computer Vision Integration (Cloud Hosted Detection)
ROBOFLOW_API_KEY=
ROBOFLOW_PROJECT_ID=warehouse-carton-det
ROBOFLOW_MODEL_VERSION=1
MODEL_ENGINE=ROBOFLOW_HOSTED

# Database & Server
ENVIRONMENT=DEVELOPMENT
HOST=0.0.0.0
PORT=8000
